{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DragonForge Authenticator",
  "version": "1.0.0-beta.1",
  "identifier": "com.dragonforge.authenticator",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DragonForge Authenticator",
        "width": 1160,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../assets/branding/logos/dragonforge-authenticator.png"
    ]
  }
}
