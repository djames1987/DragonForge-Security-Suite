{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DragonForge Security Center",
  "version": "1.0.0",
  "identifier": "com.dragonforge.securitycenter",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DragonForge Security Center",
        "width": 1360,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../assets/branding/logos/dragonforge-security-center.png"
    ]
  }
}
