{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DragonForge Integrity Monitor",
  "version": "0.1.0",
  "identifier": "com.dragonforge.integritymonitor",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DragonForge Integrity Monitor",
        "width": 1180,
        "height": 800,
        "minWidth": 920,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
