# Copy to .env. Never commit populated secrets.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DRAGONFORGE_SYNC_ADMIN_TOKEN=replace-with-a-64-character-hexadecimal-256-bit-secret
DRAGONFORGE_SYNC_ENVIRONMENT=production
DRAGONFORGE_SYNC_TLS_PROXY=true
DRAGONFORGE_SYNC_PUBLIC_BASE_URL=https://sync.example.com
DRAGONFORGE_SYNC_RATE_LIMIT_REQUESTS=240
DRAGONFORGE_SYNC_RATE_LIMIT_WINDOW_SECONDS=60
